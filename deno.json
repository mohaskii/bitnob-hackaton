{
  "tasks": {
    "dev": "deno run -A app/build-config.ts",
    "server": "deno run --env-file -A --unstable-worker-options --unstable-ffi api/server.ts",
    "db:seed": "deno run --env-file -A --unstable-ffi api/task-seed.ts",
    "db:reset": "deno run -A --env-file --unstable-ffi api/task-reset.ts",
    "test": "DATABASE_PATH=:memory: APP_ENV=test deno test -A --unstable-ffi api/",
    "bitnob:check": "deno run -A --env-file --unstable-ffi api/task-bitnob-check.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "metafile.json"
    ]
  },
  "lock": false,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "exactOptionalPropertyTypes": false,
    "lib": [
      "deno.window",
      "deno.ns",
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "webworker"
    ]
  },
  "imports": {
    "@01edu/api": "jsr:@01edu/api@^0.1.7",
    "@01edu/api-client": "jsr:@01edu/api-client@^0.1.7",
    "@01edu/db": "jsr:@01edu/db@^0.1.7",
    "@01edu/time": "jsr:@01edu/time@^0.1.0",
    "@01edu/types": "jsr:@01edu/types@^0.1.4",
    "@capacitor/app": "npm:@capacitor/app@^8.1.0",
    "@capacitor/camera": "npm:@capacitor/camera@^8.2.0",
    "@capacitor/core": "npm:@capacitor/core@^8.3.4",
    "@db/sqlite": "jsr:@cd/sqlite@^0.12.0",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.5",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/crypto": "jsr:@std/crypto@^1.0.4",
    "@std/encoding": "jsr:@std/encoding@^1.0.7",
    "@std/http": "jsr:@std/http@^1.0.13",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "capacitor": "npm:capacitor@^0.5.6",
    "daisyui": "npm:daisyui@^5.5.20",
    "gsap": "npm:gsap@^3.15.0",
    "lucide-preact": "npm:lucide-preact@^1.16.0",
    "preact": "npm:preact@^10.29.2",
    "qrcode-generator": "npm:qrcode-generator@1.4.4",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "vite": "npm:vite@^8.0.14"
  }
}
