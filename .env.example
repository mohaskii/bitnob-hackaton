# TekkiTrade environment. Copy to .env and adjust.
DATABASE_PATH=tekkitrade.db
PORT=8000
# HMAC key for session tokens. Required in production.
SESSION_SECRET=change-me

# Bitnob (https://bitnob.dev). Leave the credentials empty to run in simulation mode.
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# sandbox | live (the secret decides the environment on Bitnob's side)
BITNOB_ENV=sandbox
BITNOB_WEBHOOK_SECRET=

# Indicative rates used only in simulation mode
SIM_USD_XOF_RATE=565
SIM_BTC_XOF_RATE=60000000
SIM_BITNOB_FEE_RATE=0.01
# Stablecoin deposit chain (sandbox: ethereum = Sepolia testnet)
BITNOB_STABLECOIN_CHAIN=ethereum

# Tekki AI / Tekki Voice (keys stay server-side)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Alternative providers
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3:8b
# Fallback models when the primary one is overloaded (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
GEMINI_THINKING_LEVEL=minimal
# Wolof voice: Oolel-Voices sidecar (tools/oolel). Empty = Gemini only.
OOLEL_TTS_URL=http://127.0.0.1:8010
